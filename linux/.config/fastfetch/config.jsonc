{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "command-raw",
        "source": "pokemon-logo.sh",
        "padding": {
            "top": 1,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "key": {
            "width": 14
        }
    },
    "modules": [
        {
            "type": "title",
            "key": "󰀄 user",
            "format": "{1}"
        },
        {
            "type": "os",
            "key": "󰟾 distro"
        },
        {
            "type": "host",
            "key": "󰌢 host"
        },
        {
            "type": "kernel",
            "key": " kernel"
        },
        {
            "type": "uptime",
            "key": "󱦟 uptime"
        },
        {
            "type": "packages",
            "key": "󰏗 pkgs"
        },
        {
            "type": "shell",
            "key": " shell"
        },
        {
            "type": "terminal",
            "key": " term"
        },
        {
            "type": "display",
            "key": "󰍹 display",
            "compactType": "original"
        },
        {
            "type": "wm",
            "key": "󰖲 wm"
        },
        {
            "type": "cpu",
            "key": "󰻠 cpu"
        },
        {
            "type": "gpu",
            "key": "󰢮 gpu"
        },
        {
            "type": "memory",
            "key": "󰍛 memory"
        },
        {
            "type": "disk",
            "key": "󰋊 disk",
            "folders": "/"
        },
        {
            "type": "break"
        },
        {
            "type": "colors",
            "key": "󰏘 colors",
            "symbol": "circle"
        }
    ]
}
