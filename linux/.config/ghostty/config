theme = dankcolors

background-opacity = 0.8
background-blur = 32

font-family = "ZedMono Nerd Font Mono"
font-family = "JetBrainsMono Nerd Font Mono"

font-size = 14
adjust-cell-height = 8%

window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
window-decoration = none

gtk-titlebar = false

window-save-state = never
window-inherit-working-directory = true
window-inherit-font-size = true

resize-overlay = never
confirm-close-surface = false

quit-after-last-window-closed = true

gtk-single-instance = true
gtk-tabs-location = top
gtk-wide-tabs = true

window-show-tab-bar = auto

cursor-style-blink = true
cursor-style = block
cursor-opacity = 1

shell-integration = zsh
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo

scrollback-limit = 25000000
copy-on-select = clipboard

clipboard-trim-trailing-spaces = true
clipboard-paste-bracketed-safe = true
clipboard-paste-protection = true

mouse-hide-while-typing = true
focus-follows-mouse = false

unfocused-split-opacity = 0.85
minimum-contrast = 1.1
link-url = true

keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab

keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# Splits
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+alt+left=resize_split:left,40
keybind = ctrl+shift+alt+right=resize_split:right,40
keybind = ctrl+shift+alt+up=resize_split:up,40
keybind = ctrl+shift+alt+down=resize_split:down,40
keybind = ctrl+shift+equal=equalize_splits

# Tabs
keybind = ctrl+page_up=previous_tab
keybind = ctrl+page_down=next_tab
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5

# Dev workflow
keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+o=toggle_background_opacity
keybind = ctrl+alt+up=jump_to_prompt:-1
keybind = ctrl+alt+down=jump_to_prompt:1
keybind = ctrl+shift+k=clear_screen
keybind = ctrl+shift+j=write_scrollback_file:open
keybind = shift+enter=text:\x1b\r

# Faster page scrolling
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
