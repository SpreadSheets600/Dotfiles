window-rule {
    match title=r#"(?i)^picture[- ]in[- ]picture$"#
    open-floating true
}


window-rule {
    match title=r#"(?i)^(google )?meet(\s*[-–—].*)?$"#
    open-floating true
}


window-rule {
    match app-id=r#"(?i)meet\.google\.com"#
    open-floating true
}

window-rule {
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match is-active=false
    opacity 0.90
}

window-rule {
    match is-active=true
    opacity 0.95
}

window-rule {
    match app-id=r#"^(kitty|com\.mitchellh\.ghostty)$"#
    opacity 0.85
}
