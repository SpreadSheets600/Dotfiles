window-rule {
    match title=r#"(?i)^picture[- ]in[- ]picture$"#
    open-floating true
}


window-rule {
    match title=r#"(?i)^(google )?meet(\s*[-–—].*)?$"#
    open-floating true
}


window-rule {
    match app-id=r#"(?i)meet\.google\.com"#
    open-floating true
}

window-rule {
    background-effect {
        blur true
        xray false
    }
}

// Inactive windows.
window-rule {
    match is-active=false
    opacity 0.90
}

// Active windows (one per workspace on the focused monitor).
window-rule {
    match is-active=true
    opacity 0.95
}

// Terminals keep a bit more transparency, active or not.
window-rule {
    match app-id=r#"^kitty$"#
    opacity 0.85
}
