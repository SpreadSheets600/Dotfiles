# =============================================================================
#  ~/.gitconfig — git defaults for development
#  Managed in ~/Dotfiles/linux/.gitconfig
# =============================================================================

[user]
	name = SpreadSheets600
	email = dev.spreadsheets600@gmail.com

[init]
	defaultBranch = main

[core]
	editor = nvim
	pager = delta
	autocrlf = input

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	true-color = auto
	syntax-theme = Catppuccin Mocha

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[alias]
	st = status -sb
	lg = log --oneline --graph --decorate -20
	co = checkout
	br = branch
	last = log -1 HEAD --stat
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit

# GitHub CLI credential helper (set up by `gh auth login`)
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
