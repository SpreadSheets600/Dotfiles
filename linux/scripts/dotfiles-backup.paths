# Configs that dotfiles-sync.sh copies into the repo before each commit.
#
# Use this list for configuration that cannot be symlinked into linux/.config:
#   - apps that keep large state (caches, plugin checkouts) next to the config,
#     so linking the whole directory would drag all of it into git;
#   - apps that rewrite their config atomically, which replaces a symlink.
#
# Format: <source under $HOME> | <destination relative to the repo root>
# Lines may be commented out with #.

# DankMaterialShell: bar layout, widgets, theme, plugin state, monitors.
# The plugins/ directory (167 MB of checkouts) is deliberately left out;
# restore it with `dms plugins install <id>`.
~/.config/DankMaterialShell/settings.json|linux/snapshots/DankMaterialShell/settings.json
~/.config/DankMaterialShell/plugin_settings.json|linux/snapshots/DankMaterialShell/plugin_settings.json
~/.config/DankMaterialShell/plugins.lock.json|linux/snapshots/DankMaterialShell/plugins.lock.json
~/.config/DankMaterialShell/monitors.json|linux/snapshots/DankMaterialShell/monitors.json
~/.config/DankMaterialShell/clsettings.json|linux/snapshots/DankMaterialShell/clsettings.json

# DMS companion apps.
~/.config/dankcal/ui-settings.json|linux/snapshots/dankcal/ui-settings.json
~/.config/dsearch/config.toml|linux/snapshots/dsearch/config.toml
~/.config/dgop/colors.json|linux/snapshots/dgop/colors.json
~/.config/dgop/keybinds.json|linux/snapshots/dgop/keybinds.json

# Session environment and desktop integration.
~/.config/environment.d/90-dms.conf|linux/snapshots/environment.d/90-dms.conf
~/.config/mimeapps.list|linux/snapshots/mimeapps.list
~/.config/user-dirs.dirs|linux/snapshots/user-dirs.dirs
~/.config/xdg-terminals.list|linux/snapshots/xdg-terminals.list
~/.config/pavucontrol.ini|linux/snapshots/pavucontrol.ini
~/.config/qt5ct/qt5ct.conf|linux/snapshots/qt5ct/qt5ct.conf
~/.config/qt6ct/qt6ct.conf|linux/snapshots/qt6ct/qt6ct.conf

# Secondary shell (login shell is zsh; see linux/.zshrc).
~/.config/fish/config.fish|linux/snapshots/fish/config.fish
