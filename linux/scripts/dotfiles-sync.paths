# Paths that dotfiles-sync.sh commits and pushes to GitHub.
#
# Only what is needed to rebuild the Linux setup on another machine belongs
# here. One git pathspec per line; comments and blank lines are ignored.
# Add a line if you want more (e.g. wallpapers/ or windows/).

# Linux setup: shell files, every app config install.sh links, helper scripts
linux/

# Installer, docs, repo ignore rules
install.sh
README.md
SYSTEM.md
.gitignore
.gitmodules

# Cross-platform editor/theme configs
shared/

# Wallpaper collection: a submodule of github.com/SpreadSheets600/Wallpapers
# (the sync commits and pushes new images inside it, then records the commit)
wallpapers/
# windows/
# .github/
