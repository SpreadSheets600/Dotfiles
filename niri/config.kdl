config-notification {
    disable-failed
}

/-output "eDP-2" {
    mode "2560x1600@239.998993"
    position x=2560 y=0

    variable-refresh-rate
}

gestures {
    hot-corners {
        off
    }
}

input {
    keyboard {
        xkb {

        }

        numlock
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.1
    }

    mouse {
        accel-speed 1
    }

    trackpoint {
        accel-speed 1
    }
}

layout {
    background-color "transparent"
    center-focused-column "always"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    border {
        off
        width 4
        active-color   "#707070"      // Neutral gray
        inactive-color "#d0d0d0"      // Light gray
        urgent-color   "#cc4444"      // Softer red
    }

    shadow {
        offset x=0 y=5
        softness 30
        spread 5
        color "#0007"
    }
    struts {
    }
}

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

overview {
    workspace-shadow {
        off
    }
}

environment {
  XDG_CURRENT_DESKTOP "niri"
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot-%Y-%m-%d %H-%M-%S.png"

animations {
    workspace-switch {
        spring damping-ratio=0.80 stiffness=523 epsilon=0.0001
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.75 stiffness=323 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }
    overview-open-close {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
}

window-rule {
    opacity 0.95

    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id=r#"kitty"#

    opacity 0.85

    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id=r#"^org\.gnome\."#

    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true

    opacity 0.90

    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^org\.gnome\.Nautilus$"#
    match app-id=r#"^xdg-desktop-portal$"#
    match app-id=r#"^gnome-calculator$"#
    open-floating true
}

window-rule {
    match app-id=r#"^org\.gnome\.Nautilus$"#

    default-column-width { fixed 1080; }
    default-window-height { fixed 720; }
}

window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"

    open-focused false
}

window-rule {
    match app-id="helium"
    match app-id="kitty"
    match app-id="zen"

    draw-border-with-background false
}

window-rule {
    match title="(?i)picture-in-picture"
    match title="(?i)^pip$"

    match app-id="(?i)picture-in-picture"
    match app-id="(?i)^pip$"

    open-floating true

    default-column-width { fixed 720; }
    default-window-height { fixed 480; }
}

window-rule {
    match app-id=r#"com.danklinux.dms$"#
    match app-id=r#"org.quickshell$"#
    open-floating true

    opacity 0.80

    background-effect {
        blur true
        xray false
    }
}

debug {
    honor-xdg-activation-with-invalid-serial
}

recent-windows {
    binds {
        Alt+Shift+grave { previous-window filter="app-id"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Tab         { next-window scope="output"; }
    }
}

// Include DMS Files
include "dms/binds.kdl"
include "dms/colors.kdl"
include "dms/layout.kdl"
include "dms/alttab.kdl"
include "dms/cursor.kdl"
include "dms/outputs.kdl"

include "dms/windowrules.kdl"
