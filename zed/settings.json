// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "agent_servers": {
        "github-copilot-cli": {
            "type": "registry"
        }
    },
    "colorize_brackets": true,
    "minimap": {
        "show": "always",
        "thumb": "always",
        "thumb_border": "left_open",
        "current_line_highlight": null,
    },
    "code_lens": "on",
    "show_signature_help_after_edits": true,
    "auto_signature_help": true,
    "redact_private_values": true,
    "cli_default_open_behavior": "existing_window",
    "icon_theme": {
        "mode": "light",
        "light": "JetBrains New UI Icons (Dark)",
        "dark": "JetBrains New UI Icons (Dark)",
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "edit_predictions": {
        "provider": "zed",
    },
    "session": {
        "trust_all_worktrees": true,
    },
    "git": {
        "inline_blame": {
            "enabled": true,
        },
    },
    "gutter": {
        "line_numbers": true,
    },
    "cursor_shape": "bar",
    "cursor_blink": true,
    "show_edit_predictions": true,
    "hard_tabs": false,
    "file_finder": {
        "modal_max_width": "medium",
    },
    "scrollbar": {
        "show": "never",
    },
    "use_system_window_tabs": true,
    "base_keymap": "VSCode",
    "ui_font_size": 16,
    "buffer_font_size": 16,
    "ui_font_family": "Iosevka Nerd Font Mono",
    "buffer_font_family": "Iosevka Nerd Font Mono",
    "autosave": "on_focus_change",
    "mouse_wheel_zoom": true,
    "tab_size": 4,
    "tab_bar": {
        "show": true,
    },
    "tabs": {
        "file_icons": true,
        "git_status": true,
        "show_diagnostics": "all",
    },
    "agent": {
        "default_model": {
            "provider": "copilot_chat",
            "model": "claude-3-7-sonnet",
        },
    },
    "inlay_hints": {
        "enabled": true,
    },
    "indent_guides": {
        "enabled": true,
        "line_width": 1,
        "active_line_width": 2,
        "coloring": "indent_aware",
    },
    "always_treat_brackets_as_autoclosed": true,
    "lsp": {
        "json-language-server": {
            "settings": {
                "json": {
                    "schemas": [
                        {
                            "fileMatch": ["config/*.json"],
                            "url": "./schemas/custom-schema.json",
                        },
                        {
                            "fileMatch": ["*.config.json"],
                            "url": "~/global-schemas/shared.json",
                        },
                        {
                            "fileMatch": ["*/*.luarc.json"],
                            "url": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
                        },
                    ],
                },
            },
        },
        "gopls": {
            "initialization_options": {
                "hints": {
                    "assignVariableTypes": true,
                    "compositeLiteralFields": true,
                    "compositeLiteralTypes": true,
                    "constantValues": true,
                    "functionTypeParameters": true,
                    "parameterNames": true,
                    "rangeVariableTypes": true,
                },
                "codelenses": {
                    "test": true,
                    "generate": true,
                    "regenerate_cgo": true,
                    "tidy": true,
                    "upgrade_dependency": true,
                    "vendor": true,
                },
            },
        },
        "tailwindcss-language-server": {
            "settings": {
                "includeLanguages": {
                    "astro": "html",
                },
                "experimental": {
                    "classRegex": [
                        "class=\"([^\"]*)\"",
                        "class='([^']*)'",
                        "class:list=\"{([^}]*)}\"",
                        "class:list='{([^}]*)}'",
                    ],
                },
            },
        },
    },
    "languages": {
        "Shell Script": {
            "tab_size": 4,
            "hard_tabs": false,
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "shfmt",
                    "arguments": [
                        "--filename",
                        "{buffer_path}",
                        "--indent",
                        "2",
                    ],
                },
            },
        },
        "SQL": {
            "formatter": {
                "external": {
                    "command": "sql-formatter",
                    "arguments": ["--language", "mysql"],
                },
            },
        },
        "Markdown": {
            "format_on_save": "on",
            "extend_list_on_newline": false,
            "remove_trailing_whitespace_on_save": false,
        },
        "C": {
            "format_on_save": "on",
            "tab_size": 4,
        },
        "Python": {
            "show_whitespaces": "all",
            "show_edit_predictions": true,
            "hard_tabs": false,
            "format_on_save": "on",
            "formatter": {
                "language_server": {
                    "name": "ruff",
                },
            },
            "language_servers": [
                "ty",
                "ruff",
                "!basedpyright",
                "!pyrefly",
                "!pyright",
                "!pylsp",
            ],
        },
        "TypeScript": {
            "show_whitespaces": "all",
            "show_edit_predictions": true,
            "hard_tabs": false,
            "inlay_hints": {
                "enabled": true,
                "show_parameter_hints": false,
                "show_other_hints": true,
                "show_type_hints": true,
            },
        },
        "JavaScript": {
            "tab_size": 4,
            "formatter": {
                "external": {
                    "command": "prettier",
                    "arguments": ["--stdin-filepath", "{buffer_path}"],
                },
            },
        },
        "HTML": {
            "formatter": {
                "external": {
                    "command": "prettier",
                    "arguments": ["--stdin-filepath", "{buffer_path}"],
                },
            },
        },
    },
    "toolbar": {
        "breadcrumbs": true,
        "code_actions": true,
        "quick_actions": true,
        "selections_menu": true,
    },
    "outline_panel": {
        "dock": "right",
    },
    "project_panel": {
        "dock": "right",
        "button": true,
        "git_status": true,
        "auto_fold_dirs": true,
    },
    "collaboration_panel": {
        "dock": "right",
    },
    "auto_install_extensions": {
        "git-firefly": true,
        "ruff": true,
        "toml": true,
    },
    "terminal": {
        "shell": "system",
        "show_count_badge": true,
        "font_size": 16.0,
        "font_family": "Iosevka Nerd Font Mono",
        "env": {
            "EDITOR": "zed --wait",
        },
    },
    "file_types": {
        "Dockerfile": ["Dockerfile", "Dockerfile.*"],
        "JSON": ["json", "jsonc", "*.code-snippets"],
        "C": ["C", "H"],
    },
    "file_scan_exclusions": [
        "**/.git",
        "**/.svn",
        "**/.hg",
        "**/CVS",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/.classpath",
        "**/.settings",
        "**/out",
        "**/dist",
        "**/.husky",
        "**/.turbo",
        "**/.vscode-test",
        "**/.vscode",
        "**/.next",
        "**/.storybook",
        "**/.tap",
        "**/.nyc_output",
        "**/report",
        "**/node_modules",
    ],
    "theme": {
        "mode": "dark",
        "light": "DankShell Light",
        "dark": "Zed Cursor Dark",
    },
}
